{
  "name": "dsh-peer-sync",
  "version": "0.12.7",
  "private": true,
  "type": "module",
  "description": "Keeps profile configuration, credential refs and agent presets identical across two DSH machines linked by a direct cable.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yc5991/dsh-peer-sync.git"
  },
  "homepage": "https://github.com/yc5991/dsh-peer-sync#readme",
  "bugs": {
    "url": "https://github.com/yc5991/dsh-peer-sync/issues"
  },
  "keywords": [
    "dsh",
    "cordis",
    "peer-to-peer",
    "sync",
    "webdav"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "test/*.mjs",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "dependencies": {
    "yaml": "^2.6.1"
  }
}
